#!/bin/sh

# Redirect output to stderr so Git displays hook diagnostics.
exec 1>&2

verify_bib_file() {
  input=$1
  output=$(mktemp "${TMPDIR:-/tmp}/references-bibtool.XXXXXX") || return 1
  diagnostics=$(mktemp "${TMPDIR:-/tmp}/references-bibtool.XXXXXX") || {
    rm -f "$output"
    return 1
  }

  bibtool -q -r bibtool.rsc -i "./$input" -o "$output" \
    2>"$diagnostics"
  bibtool_status=$?

  # BibTool reports unresolved crossrefs as errors even though it successfully
  # formats the self-contained entries in this legacy database.
  if [ "$bibtool_status" -ne 0 ] ||
    grep -Ev '^$|^\*\*\* BibTool ERROR: Crossref not found: $' \
      "$diagnostics" | grep -q .; then
    cat "$diagnostics"
    rm -f "$output" "$diagnostics"
    return 1
  fi
  rm -f "$diagnostics"

  if cmp -s "$input" "$output"; then
    rm -f "$output"
    return 0
  fi

  cp -f "$output" "$input"
  rm -f "$output"
  printf '\n%s was reformatted by BibTool.\n' "$input"
  printf 'Review and stage the result, then commit again.\n\n'
  return 1
}

git diff --cached --name-only --diff-filter=AM -- '*.bib' |
  while IFS= read -r input; do
    if ! verify_bib_file "$input"; then
      exit 1
    fi
  done
